# ─── Backend (.env in /backend) ───────────────────────────────

# LP Agent API key — get from https://portal.lpagent.io/
LP_AGENT_API_KEY=your_lp_agent_api_key_here

# Anthropic API key for AI Advisor — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Port (default 4000)
PORT=4000


# ─── Frontend (.env in /frontend) ──────────────────────────────

# Backend URL
VITE_API_URL=http://localhost:4000/api

# Solana RPC endpoint (use your own for production)
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
